// Prisma schema for IoT Logistics Backend
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())
}

model Device {
  id           Int              @id @default(autoincrement())
  deviceId     String           @unique
  name         String?
  secretHash   String
  createdAt    DateTime         @default(now())
  readings     SensorReading[]
  locations    DeviceLocation[]
  thresholds   Threshold[]
  alerts       Alert[]
  shipments    Shipment[]
}

model Vehicle {
  id         Int          @id @default(autoincrement())
  plate      String       @unique
  name       String?
  createdAt  DateTime     @default(now())
  shipments  Shipment[]
}

model Order {
  id         Int              @id @default(autoincrement())
  code       String           @unique
  product    String
  createdAt  DateTime         @default(now())
  shipments  ShipmentOrder[]
}

model Shipment {
  id         Int             @id @default(autoincrement())
  device     Device          @relation(fields: [deviceId], references: [id])
  deviceId   Int
  vehicle    Vehicle         @relation(fields: [vehicleId], references: [id])
  vehicleId  Int
  route      String?
  startedAt  DateTime        @default(now())
  endedAt    DateTime?
  orders     ShipmentOrder[]
}

model ShipmentOrder {
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId Int
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    Int
  @@id([shipmentId, orderId])
}

model SensorReading {
  id         Int       @id @default(autoincrement())
  device     Device    @relation(fields: [deviceId], references: [id])
  deviceId   Int
  type       String    // "temperature", "humidity", "pressure"
  value      Float
  createdAt  DateTime  @default(now())
}

model DeviceLocation {
  id         Int       @id @default(autoincrement())
  device     Device    @relation(fields: [deviceId], references: [id])
  deviceId   Int
  latitude   Float
  longitude  Float
  createdAt  DateTime  @default(now())
}

model Threshold {
  id        Int       @id @default(autoincrement())
  device    Device    @relation(fields: [deviceId], references: [id])
  deviceId  Int
  type      String
  min       Float
  max       Float
  alerts    Alert[]
  @@unique([deviceId, type], name: "deviceId_type")
}

model Alert {
  id           Int        @id @default(autoincrement())
  device       Device     @relation(fields: [deviceId], references: [id])
  deviceId     Int
  type         String
  value        Float
  createdAt    DateTime   @default(now())
  threshold    Threshold  @relation(fields: [thresholdId], references: [id])
  thresholdId  Int
}

