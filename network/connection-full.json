{
    "name": "supply-chain-network",
    "version": "1.0.0",
    "client": {
        "organization": "OrgManufacturer",
        "connection": {
            "timeout": {
                "peer": {
                    "endorser": "300"
                },
                "orderer": "300"
            }
        }
    },
    "organizations": {
        "OrgManufacturer": {
            "mspid": "OrgManufacturerMSP",
