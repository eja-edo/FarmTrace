{
    "name": "supply-chain-network",
    "version": "1.0.0",
    "client": {
        "organization": "OrgManufacturer",
        "connection": {
            "timeout": {
                "peer": {
                    "endorser": "300"
                },
                "orderer": "300"
            }
        }
    },
    "channels": {
        "supplychain-channel": {
            "orderers": [
                "orderer.example.com"
            ],
            "peers": {
                "peer0.manufacturer.example.com": {
                    "endorsingPeer": true,
                    "chaincodeQuery": true,
                    "ledgerQuery": true,
                    "eventSource": true
                }
            }
        }
    },
    "organizations": {
        "OrgManufacturer": {
            "mspid": "OrgManufacturerMSP",
            "peers": [
                "peer0.manufacturer.example.com"
            ],
            "certificateAuthorities": [
                "ca.manufacturer.example.com"
            ]
        }
    },
    "orderers": {
        "orderer.example.com": {
            "url": "grpcs://orderer.example.com:7050",
            "tlsCACerts": {
                "path": "/crypto-config/ordererOrganizations/example.com/orderers/orderer.example.com/tls/ca.crt"
            },
            "grpcOptions": {
                "ssl-target-name-override": "orderer.example.com",
                "hostnameOverride": "orderer.example.com"
            }
        }
    },
    "peers": {
        "peer0.manufacturer.example.com": {
            "url": "grpcs://peer0.manufacturer.example.com:7051",
            "tlsCACerts": {
                "path": "/crypto-config/peerOrganizations/manufacturer.example.com/peers/peer0.manufacturer.example.com/tls/ca.crt"
            },
            "grpcOptions": {
                "ssl-target-name-override": "peer0.manufacturer.example.com",
                "hostnameOverride": "peer0.manufacturer.example.com"
            }
        },
        "peer0.shipper.example.com": {
            "url": "grpcs://peer0.shipper.example.com:8051",
            "tlsCACerts": {
                "path": "/crypto-config/peerOrganizations/shipper.example.com/peers/peer0.shipper.example.com/tls/ca.crt"
            },
            "grpcOptions": {
                "ssl-target-name-override": "peer0.shipper.example.com",
                "hostnameOverride": "peer0.shipper.example.com"
            }
        },
        "peer0.warehouse.example.com": {
            "url": "grpcs://peer0.warehouse.example.com:9051",
            "tlsCACerts": {
                "path": "/crypto-config/peerOrganizations/warehouse.example.com/peers/peer0.warehouse.example.com/tls/ca.crt"
            },
            "grpcOptions": {
                "ssl-target-name-override": "peer0.warehouse.example.com",
                "hostnameOverride": "peer0.warehouse.example.com"
            }
        },
        "peer0.retailer.example.com": {
            "url": "grpcs://peer0.retailer.example.com:10051",
            "tlsCACerts": {
                "path": "/crypto-config/peerOrganizations/retailer.example.com/peers/peer0.retailer.example.com/tls/ca.crt"
            },
            "grpcOptions": {
                "ssl-target-name-override": "peer0.retailer.example.com",
                "hostnameOverride": "peer0.retailer.example.com"
            }
        }
    },
    "certificateAuthorities": {
        "ca.manufacturer.example.com": {
            "url": "https://ca.manufacturer.example.com:7054",
            "caName": "ca-manufacturer",
            "tlsCACerts": {
                "path": "/crypto-config/peerOrganizations/manufacturer.example.com/ca/ca.manufacturer.example.com-cert.pem"
            },
            "httpOptions": {
                "verify": false
            }
        }
    }
}