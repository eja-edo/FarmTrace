# Gateway API Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# Fabric Network Configuration
CHANNEL_NAME=supplychain-channel
CHAINCODE_NAME=supplychain_cc

# Connection Profile Path
CONNECTION_PROFILE_PATH=../../network/connection-manufacturer.json

# Wallet Path
WALLET_PATH=./wallet

# Identity Configuration
ORG_MSP_ID=OrgManufacturerMSP
USER_ID=appUser

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supplychain
DB_USER=postgres
DB_PASSWORD=postgres

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
