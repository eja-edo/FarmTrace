{
    "verbose": true,
    "ignore": [
        ".git",
        "node_modules",
        "prisma/migrations",
        "*.test.js"
    ],
    "watch": [
        "src/**/*",
        "prisma/schema.prisma"
    ],
    "ext": "js,mjs,json,prisma",
    "legacyWatch": true,
    "delay": 1000,
    "signal": "SIGTERM"
}